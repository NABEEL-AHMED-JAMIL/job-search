# Copy to .env and fill in. .env is not tracked; nothing in this file ever holds a real value.
#
# docker-compose.yml reads the credentials below as ${VAR:?}, so the stack refuses to come up
# until they are set -- they are deliberately not defaulted in the compose file, because a
# default committed to the repository is the value the deployment ends up running on.
#
# The host-venv workflow (run_tpd_scrapping_listener.sh and friends) reads its own addresses
# and topics from the same .env; those are not repeated here.

# Shared secret for the /changeState and /addLogs callbacks. Must match process's
# worker.callback.token, or the backend rejects them and job status stops updating.
WORKER_CALLBACK_TOKEN=

# MinIO object storage. Also required by the host-venv workflow: etl/util/minio_client.py has
# no defaults either, so a worker started without these raises instead of connecting.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# v4_backend Postgres, used by the F768920 pipeline. The user is required as well -- the
# account name that used to be defaulted in etl/util/v4_backend_client.py was a developer's own.
V4_BACKEND_USER=
V4_BACKEND_PASSWORD=

# Kafka broker security. Leave empty for the PLAINTEXT stack. Set KAFKA_SECURITY_PROTOCOL to
# SASL_PLAINTEXT, SSL or SASL_SSL to reach a secured cluster; a SASL protocol without both a
# username and a password is refused rather than connecting anonymously. The ssl_* variables
# are paths that have to exist inside the container.
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=
KAFKA_SSL_CERTFILE=
KAFKA_SSL_KEYFILE=

# ─────────────────────────────────────────────────────────────────────────────────────────────
# Supporting stacks under docker-files/. These replace the plain 'env' file that used to sit
# beside this one. Compose reads .env from the directory holding the compose file, so run those
# stacks from the repo root or pass --env-file ../.env, otherwise the variables arrive unset.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# MongoDB root account (docker-compose.yml, docker-compose.full.yml). Also used by mongo-express
# to connect, so a character needing URI escaping in the password has to be percent-encoded.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# Application account created by init-mongo.js on the first container start only. Changing it
# afterwards has no effect until the mongo_data volume is recreated.
MONGO_APP_USER=
MONGO_APP_PASSWORD=

# Optional: database the app account is created in. Defaults to mydb when unset.
MONGO_DATABASE=

# Basic-auth login for the mongo-express UI, which is otherwise open on port 8081.
ME_BASICAUTH_USER=
ME_BASICAUTH_PASSWORD=

# Grafana admin login (docker-compose.monitoring.yml).
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Redis requirepass (docker-compose.monitoring.yml). Shared by redis-commander and flower, and
# redis-commander parses it out of a colon-delimited string, so it cannot contain a colon.
REDIS_PASSWORD=

# Signs Open WebUI session cookies (docker-compose.ollama.yml). Anyone holding this value can
# mint a valid session, so it must be generated per deployment rather than shared.
WEBUI_SECRET_KEY=

# etl-meter: the usage ledger (see etl/meter). Same Postgres as the console, schema meter.
# e.g. postgresql://USER:PASSWORD@host.docker.internal:5433/etl_job
METER_DATABASE_URL=
METER_SERVICE_KEY=
